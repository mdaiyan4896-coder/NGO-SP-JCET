// Prisma Schema for VolunEase (Volunteer Management System for NGOs)
// Meets Prompts 3, 4, 5, 7, 8 specifications

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ORG_ADMIN
  COORDINATOR
  VIEWER
  VOLUNTEER
}

enum VolunteerStatus {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  ONGOING
  COMPLETED
  CANCELLED
}

enum RegistrationStatus {
  REGISTERED
  WAITLISTED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  EXCUSED
}

enum CheckInMethod {
  QR_CODE
  MANUAL
  GEO_LOCATION
}

enum TargetAudience {
  ALL_VOLUNTEERS
  EVENT_VOLUNTEERS
  SPECIFIC
}

// -------------------------------------------------------------
// Core Entities
// -------------------------------------------------------------

model Organization {
  id               String   @id @default(cuid())
  name             String
  logoUrl          String?
  description      String?  @db.Text
  address          String?
  contactEmail     String
  contactPhone     String?
  website          String?
  aiCreditsBalance Int      @default(500)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users            User[]
  volunteers       Volunteer[]
  events           Event[]
  announcements    Announcement[]
  activityLogs     ActivityLog[]
  aiUsageLogs      AiUsageLog[]

  @@index([name])
}

model User {
  id                   String                 @id @default(cuid())
  organizationId       String
  email                String                 @unique
  passwordHash         String
  firstName            String
  lastName             String
  role                 Role                   @default(COORDINATOR)
  avatarUrl            String?
  phone                String?
  bio                  String?                @db.Text
  timezone             String                 @default("UTC")
  language             String                 @default("en")
  isActive             Boolean                @default(true)
  emailVerified        Boolean                @default(false)
  twoFactorEnabled     Boolean                @default(false)
  twoFactorSecret      String?
  twoFactorBackupCodes String[]               @default([])
  failedLoginAttempts  Int                    @default(0)
  lockedUntil          DateTime?
  lastLoginAt          DateTime?
  deletedAt            DateTime?              // Soft-delete 30-day grace
  scheduledPurgeAt     DateTime?
  refreshTokenVersion  Int                    @default(1)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  organization         Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  coordinatedEvents    Event[]                @relation("EventCoordinator")
  announcements        Announcement[]
  notifications        Notification[]
  sessions             Session[]
  preferences          NotificationPreference?

  @@index([organizationId])
  @@index([email])
}

model Volunteer {
  id                     String                 @id @default(cuid())
  organizationId         String
  email                  String
  passwordHash           String?
  firstName              String
  lastName               String
  phone                  String?
  dateOfBirth            DateTime?
  address                String?
  avatarUrl              String?
  bio                    String?                @db.Text
  status                 VolunteerStatus        @default(ACTIVE)
  joinedAt               DateTime               @default(now())
  emergencyContactName   String?
  emergencyContactPhone  String?
  totalHoursContributed  Float                  @default(0.0)
  reliabilityScore       Float                  @default(100.0) // % attendance rate
  twoFactorEnabled       Boolean                @default(false)
  twoFactorSecret        String?
  twoFactorBackupCodes   String[]               @default([])
  deletedAt              DateTime?              // Soft-delete 30-day grace
  scheduledPurgeAt       DateTime?
  refreshTokenVersion    Int                    @default(1)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  organization           Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  skills                 VolunteerSkill[]
  registrations          EventRegistration[]
  attendanceRecords      AttendanceRecord[]
  notifications          Notification[]
  sessions               Session[]
  preferences            NotificationPreference?
  chatSessions           ChatSession[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([status])
}

model Skill {
  id         String           @id @default(cuid())
  name       String           @unique
  category   String
  createdAt  DateTime         @default(now())

  volunteers VolunteerSkill[]
  roles      EventRole[]
}

model VolunteerSkill {
  id               String    @id @default(cuid())
  volunteerId      String
  skillId          String
  proficiencyLevel String?   // "Beginner" | "Intermediate" | "Expert"

  volunteer        Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  skill            Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([volunteerId, skillId])
  @@index([volunteerId])
  @@index([skillId])
}

model Event {
  id             String              @id @default(cuid())
  organizationId String
  title          String
  description    String              @db.Text
  category       String
  location       String
  latitude       Float?
  longitude      Float?
  startDateTime  DateTime
  endDateTime    DateTime
  capacity       Int
  status         EventStatus         @default(PUBLISHED)
  isRecurring    Boolean             @default(false)
  recurrenceRule String?             // iCal RRULE
  coordinatorId  String?
  qrCodeSecret   String              @default(cuid())
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  coordinator    User?               @relation("EventCoordinator", fields: [coordinatorId], references: [id], onDelete: SetNull)
  roles          EventRole[]
  registrations  EventRegistration[]
  attendance     AttendanceRecord[]
  announcements  Announcement[]

  @@index([organizationId])
  @@index([startDateTime, endDateTime])
  @@index([status])
}

model EventRole {
  id             String              @id @default(cuid())
  eventId        String
  roleName       String
  requiredCount  Int                 @default(1)
  requiredSkillId String?

  event          Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  requiredSkill  Skill?              @relation(fields: [requiredSkillId], references: [id], onDelete: SetNull)
  registrations  EventRegistration[]

  @@index([eventId])
}

model EventRegistration {
  id             String             @id @default(cuid())
  eventId        String
  volunteerId    String
  eventRoleId    String?
  status         RegistrationStatus @default(REGISTERED)
  registeredAt   DateTime           @default(now())

  event          Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  volunteer      Volunteer          @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  role           EventRole?         @relation(fields: [eventRoleId], references: [id], onDelete: SetNull)

  @@unique([eventId, volunteerId])
  @@index([eventId])
  @@index([volunteerId])
}

model AttendanceRecord {
  id              String           @id @default(cuid())
  eventId         String
  volunteerId     String
  checkInTime     DateTime?
  checkOutTime    DateTime?
  durationMinutes Int              @default(0)
  status          AttendanceStatus @default(PRESENT)
  checkInMethod   CheckInMethod    @default(QR_CODE)
  notes           String?
  createdAt       DateTime         @default(now())

  event           Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  volunteer       Volunteer        @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@unique([eventId, volunteerId])
  @@index([eventId])
  @@index([volunteerId])
}

model Announcement {
  id             String         @id @default(cuid())
  organizationId String
  eventId        String?
  senderId       String
  title          String
  body           String         @db.Text
  targetAudience TargetAudience @default(ALL_VOLUNTEERS)
  sentAt         DateTime       @default(now())
  createdAt      DateTime       @default(now())

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event          Event?         @relation(fields: [eventId], references: [id], onDelete: SetNull)
  sender         User           @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Notification {
  id          String    @id @default(cuid())
  userId      String?
  volunteerId String?
  type        String    // "EVENT_REMINDER", "ATTENDANCE_CONFIRMED", etc.
  title       String
  message     String    @db.Text
  isRead      Boolean   @default(false)
  createdAt   DateTime  @default(now())

  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  volunteer   Volunteer? @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([volunteerId])
}

model ActivityLog {
  id             String       @id @default(cuid())
  organizationId String
  actorId        String
  actorType      String       // "USER" | "VOLUNTEER" | "SYSTEM"
  action         String       // "LOGIN", "EVENT_CREATE", "CHECK_IN", etc.
  entityType     String       // "Event", "Volunteer", "Attendance"
  entityId       String
  metadata       Json?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([actorId])
}

model Session {
  id          String     @id @default(cuid())
  userId      String?
  volunteerId String?
  tokenHash   String     @unique
  device      String?
  browser     String?
  ipAddress   String?
  location    String?
  lastActive  DateTime   @default(now())
  expiresAt   DateTime
  createdAt   DateTime   @default(now())

  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  volunteer   Volunteer? @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([volunteerId])
}

model NotificationPreference {
  id                     String     @id @default(cuid())
  userId                 String?    @unique
  volunteerId            String?    @unique
  eventRemindersEmail    Boolean    @default(true)
  eventRemindersSms      Boolean    @default(true)
  eventRemindersInApp    Boolean    @default(true)
  newRegistrationsEmail  Boolean    @default(true)
  newRegistrationsSms    Boolean    @default(false)
  newRegistrationsInApp  Boolean    @default(true)
  attendanceConfirmEmail Boolean    @default(true)
  attendanceConfirmSms   Boolean    @default(false)
  attendanceConfirmInApp Boolean    @default(true)
  announcementsEmail     Boolean    @default(true)
  announcementsSms       Boolean    @default(true)
  announcementsInApp     Boolean    @default(true)
  weeklyDigestEmail      Boolean    @default(true)
  weeklyDigestSms        Boolean    @default(false)
  weeklyDigestInApp      Boolean    @default(false)

  user                   User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  volunteer              Volunteer? @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
}

model ChatSession {
  id          String        @id @default(cuid())
  volunteerId String
  title       String        @default("Chat with Volley")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  volunteer   Volunteer     @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  messages    ChatMessage[]

  @@index([volunteerId])
}

model ChatMessage {
  id            String      @id @default(cuid())
  chatSessionId String
  sender        String      // "user" | "assistant" | "system"
  content       String      @db.Text
  toolCalls     Json?
  createdAt     DateTime    @default(now())

  session       ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)

  @@index([chatSessionId])
}

model AiUsageLog {
  id             String       @id @default(cuid())
  organizationId String
  feature        String       // "MATCHING", "CONTENT_GEN", "VOLLEY_CHAT", "ATTENDANCE_FORECAST"
  tokensUsed     Int          @default(0)
  success        Boolean      @default(true)
  errorMessage   String?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}
