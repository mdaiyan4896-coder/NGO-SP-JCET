# =====================================================
# VolunEase Environment Configuration
# =====================================================

PORT=5000
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"
VITE_API_BASE_URL="/api/v1"

# Database (PostgreSQL via Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/voluneease?schema=public"

# Authentication & JWT Secrets
JWT_ACCESS_SECRET="voluneease_super_secret_access_jwt_key_2026_change_in_prod"
JWT_REFRESH_SECRET="voluneease_super_secret_refresh_jwt_key_2026_change_in_prod"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Email Configuration (Nodemailer / SMTP)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="voluneease_user"
SMTP_PASS="voluneease_secret"
SMTP_FROM="VolunEase Team <no-reply@voluneease.org>"

# SMS Notifications (Twilio - Optional)
TWILIO_ACCOUNT_SID="AC_mock_twilio_account_sid_for_development"
TWILIO_AUTH_TOKEN="mock_twilio_auth_token"
TWILIO_PHONE_NUMBER="+15005550006"

# Storage Driver ('local' or 's3')
STORAGE_DRIVER="local"
UPLOAD_DIR="./uploads"
AWS_S3_BUCKET="voluneease-production-storage"
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="mock_aws_access_key"
AWS_SECRET_ACCESS_KEY="mock_aws_secret_key"

# AI Integration (Anthropic Claude API for smart matching, content gen, Volley)
ANTHROPIC_API_KEY="sk-ant-api03-sample-key-for-development"
AI_MONTHLY_CREDITS_PER_ORG=1000
